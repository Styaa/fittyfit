{
  "expo": {
    "name": "Shadow Fit",
    "slug": "fittyfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shadowfit",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.styaa.fittyfit"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0812",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.styaa.fittyfit",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Shadow Fit",
      "themeColor": "#0A0812",
      "backgroundColor": "#0A0812"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0812",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shadow Fit membutuhkan akses foto untuk progress log.",
          "cameraPermission": "Shadow Fit membutuhkan kamera untuk foto progres.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shadow Fit memakai lokasi untuk menghitung jarak jalan kaki selama Mode Jalan aktif.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0A0812",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e65ae673-6873-49fc-bf1c-5e4b81e2c4da"
      }
    }
  }
}
